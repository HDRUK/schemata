                  ],
                  "is_list": false,
                  "is_optional": true,
                  "types": {
                        "title": "Doi",
                        "pattern": "^10.\\d{4,9}/[-._;()/:a-zA-Z0-9]+$",
                        "type": "string"
                  },
                  "location": "summary.doiName"
            },
            {
                  "required": true,
                  "title": "Abstract",
                  "description": "Longer abstract detailing the dataset.",
                  "guidance": "",
                  "examples": [
                        "COVID-19 Key Worker Testing Results data is required by NHS Digital to support COVID-19 requests for linkage, analysis and dissemination to other organisations who require the data in a timely manner."
                  ],
                  "is_list": false,
                  "is_optional": false,
                  "types": {
                        "title": "LongAbstractText",
                        "maxLength": 5000,
                        "minLength": 5,
                        "type": "string"
                  },
                  "location": "summary.abstract"
            },
            {
                  "required": true,
                  "title": "Keywords",
