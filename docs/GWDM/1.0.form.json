                  "is_optional": false,
                  "types": {
                        "type": "string",
                        "options": [
                              "LESS 1 WEEK",
                              "1-2 WEEKS",
                              "2-4 WEEKS",
                              "1-2 MONTHS",
                              "2-6 MONTHS",
                              "MORE 6 MONTHS",
                              "VARIABLE",
                              "NO TIMELAG",
                              "NOT APPLICABLE",
                              "OTHER",
                              null
