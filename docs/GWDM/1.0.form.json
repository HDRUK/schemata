                        "Preprints,Papers,HDR UK"
                  ],
                  "is_list": false,
                  "is_optional": true,
                  "types": {
                        "title": "CommaSeparatedValues",
                        "pattern": "([^,]+)",
                        "type": "string"
                  },
                  "location": "summary.keywords"
