{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "healthdcatap": "http://healthdataportal.eu/ns/health#",
    "dpv": "http://www.w3.org/ns/dpv#",
    "dqv": "http://www.w3.org/ns/dqv#",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "adms": "http://www.w3.org/ns/adms#",
    "spdx": "http://spdx.org/rdf/terms#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "summary": "@nest",
    "documentation": "@nest",
    "coverage": "@nest",
    "provenance": "@nest",
    "accessibility": "@nest",
    "access": "@nest",
    "usage": "@nest",
    "formatAndStandards": "@nest",
    "temporal": "@nest",
    "origin": "@nest",

    "identifier": "dcterms:identifier",
    "version": "dcat:version",
    "issued": { "@id": "dcterms:issued", "@type": "xsd:dateTime" },
    "modified": { "@id": "dcterms:modified", "@type": "xsd:dateTime" },
    "revisions": "adms:versionNotes",

    "title": "dcterms:title",
    "abstract": "dcterms:description",
    "shortTitle": "dcterms:alternative",
    "keywords": "dcat:keyword",
    "controlledKeywords": "dcat:keyword",
    "doiName": { "@id": "dcterms:identifier", "@type": "@id" },
    "licenseUrl": { "@id": "dcterms:license", "@type": "@id" },
    "landingPage": { "@id": "dcat:landingPage", "@type": "@id" },
    "contactPoint": "dcat:contactPoint",
    "dataCustodian": "dcterms:publisher",
    "creator": { "@id": "dcterms:creator", "@type": "foaf:Agent" },
    "theme": { "@id": "dcat:theme", "@type": "@id" },
    "populationSize": "healthdcatap:numberOfUniqueIndividuals",
    "datasetAliases": "dcterms:alternative",

    "name": "foaf:name",
    "rorId": { "@id": "foaf:page", "@type": "@id" },
    "orcidId": { "@id": "foaf:page", "@type": "@id" },

    "spatial": { "@id": "dcterms:spatial", "@type": "@id" },
    "followUp": "healthdcatap:followUp",
    "pathway": "healthdcatap:pathway",
    "typicalAgeRangeMin": "healthdcatap:minTypicalAge",
    "typicalAgeRangeMax": "healthdcatap:maxTypicalAge",
    "populationCoverage": "healthdcatap:populationCoverage",
    "numberOfUniqueIndividuals": "healthdcatap:numberOfUniqueIndividuals",
    "numberOfRecords": "healthdcatap:numberOfRecords",
    "datasetCompleteness": "healthdcatap:completeness",

    "startDate": { "@id": "dcterms:temporal", "@type": "xsd:date" },
    "endDate": { "@id": "dcterms:temporal", "@type": "xsd:date" },
    "timeLag": "healthdcatap:timeLag",
    "publishingFrequency": "dcterms:accrualPeriodicity",
    "distributionReleaseDate": { "@id": "dcterms:issued", "@type": "xsd:date" },
    "retentionPeriod": "healthdcatap:retentionPeriod",

    "purpose": "dcterms:purpose",
    "source": "dcterms:source",
    "datasetType": "dcterms:type",
    "collectionSource": "healthdcatap:collectionSource",

    "accessRights": { "@id": "dcterms:accessRights", "@type": "@id" },
    "accessService": "dcat:accessService",
    "accessRequestCost": "healthdcatap:accessRequestCost",
    "deliveryLeadTime": "healthdcatap:deliveryLeadTime",
    "jurisdiction": { "@id": "dcterms:spatial", "@type": "@id" },
    "dataController": "dpv:hasDataController",
    "dataProcessor": "dpv:hasDataProcessor",
    "accessServiceCategory": "healthdcatap:accessServiceCategory",
    "legalBasis": "dpv:hasLegalBasis",
    "applicableLegislation": "dcatap:applicableLegislation",
    "personalData": "dpv:hasPersonalData",

    "dataUseLimitation": "dcterms:rights",
    "dataUseRequirements": "odrl:obligation",
    "resourceCreator": "dcterms:creator",

    "vocabularyEncodingScheme": "dcterms:subject",
    "conformsTo": { "@id": "dcterms:conformsTo", "@type": "@id" },
    "language": "dcterms:language",
    "format": "dcterms:format",

    "distributions": "dcat:distribution",
    "qualityAnnotations": "dqv:qualityAnnotation",

    "accessUrl": { "@id": "dcat:accessURL", "@type": "@id" },
    "downloadUrl": { "@id": "dcat:downloadURL", "@type": "@id" },
    "mediaType": "dcat:mediaType",
    "byteSize": "dcat:byteSize",

    "annotationType": "dqv:isMeasurementOf",
    "qualityDimension": "dqv:inDimension",
    "qualityValue": "dqv:value",
    "qualityDescription": "skos:note",
    "certificationUrl": { "@id": "prov:wasDerivedFrom", "@type": "@id" },
    "annotationDate": { "@id": "prov:generatedAtTime", "@type": "xsd:dateTime" }
  }
}
